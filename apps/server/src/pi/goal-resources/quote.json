{
  "name": "check_quote",
  "description": "在给定文本中逐字核对引文，返回是否匹配及首次匹配的起始行。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "text": {"type": "string", "description": "待核对的原文"},
      "quote": {"type": "string", "minLength": 1, "description": "需要定位的非空引文"}
    },
    "required": ["text", "quote"],
    "additionalProperties": false
  }
}
